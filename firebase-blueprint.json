{
  "entities": {
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A single message in the AI chat history.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "ai"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "actions": { "type": "array" }
      },
      "required": ["role", "text"]
    },
    "ChatThread": {
      "title": "Chat Thread",
      "description": "A conversation thread associated with a analyzed file.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "lastActive": { "type": "number" }
      },
      "required": ["title", "lastActive"]
    },
    "User": {
      "title": "User Profile",
      "description": "User account settings and status.",
      "type": "object",
      "properties": {
        "banned": { "type": "boolean" },
        "role": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "SystemSetting": {
      "title": "System Setting",
      "description": "Global settings for the application.",
      "type": "object",
      "properties": {
        "maintenance": { "type": "boolean" },
        "maintenanceMessageEn": { "type": "string" },
        "maintenanceMessageVi": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/system/{settingId}": {
      "schema": "SystemSetting",
      "description": "Global application system settings and configurations."
    },
    "/users/{userId}/files/{fileId}/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Legacy messages sent in the AI analysis tab for a specific file."
    },
    "/users/{userId}/files/{fileId}/chat_threads/{threadId}": {
      "schema": "ChatThread",
      "description": "Conversation threads for a specific file."
    },
    "/users/{userId}/files/{fileId}/chat_threads/{threadId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages sent in a specific chat thread."
    }
  }
}
